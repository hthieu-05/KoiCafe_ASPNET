@model List<Dictionary<string, object>>
@{ ViewData["Title"] = "Quản Lý Thực Đơn"; }

<style>
    .table-card { background: #fff; border-radius: 10px; padding: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
</style>

<div class="topbar d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark m-0"><i class="fas fa-coffee text-warning me-2"></i> QUẢN LÝ THỰC ĐƠN</h4>
    <button class="btn btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#addProductModal">
        <i class="fas fa-plus"></i> Thêm Món Mới
    </button>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success fw-bold text-center shadow-sm">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger fw-bold text-center shadow-sm">@TempData["Error"]</div> }

<div class="table-card">
    <table class="table table-hover align-middle text-center">
        <thead class="table-dark">
            <tr><th>Ảnh</th><th>Tên Món</th><th>Danh Mục</th><th>Giá Bán</th><th>Trạng Thái</th><th>Thao Tác</th></tr>
        </thead>
        <tbody>
            @foreach (var sp in Model)
            {
                <tr>
                    <td>
                        @if(sp["HinhAnh"] != DBNull.Value && !string.IsNullOrEmpty(sp["HinhAnh"].ToString())) {
                            <img src="@sp["HinhAnh"]" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;">
                        } else {
                            <i class="fas fa-mug-hot fs-3 text-muted"></i>
                        }
                    </td>
                    <td class="fw-bold text-dark">@sp["TenSP"]</td>
                    <td><span class="badge bg-secondary">@sp["TenDM"]</span></td>
                    <td class="fw-bold text-danger">@Convert.ToDecimal(sp["DonGia"]).ToString("N0") đ</td>
                    <td>
                        @if(Convert.ToBoolean(sp["TrangThai"])) { <span class="badge bg-success">Đang bán</span> } 
                        else { <span class="badge bg-danger">Ngừng bán</span> }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="openEditModal(@sp["MaSP"])"><i class="fas fa-edit"></i></button>
                        <form action="/Menu/Delete/@sp["MaSP"]" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa món này?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Thêm Món Mới -->
<div class="modal fade" id="addProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">Thêm Sản Phẩm Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form action="/Menu/Create" method="POST">
                    <div class="mb-3"><label class="fw-bold small">Tên sản phẩm</label><input type="text" class="form-control" name="TenSP" required></div>
                    <div class="mb-3">
                        <label class="fw-bold small">Danh mục sản phẩm</label>
                        <select class="form-select" name="MaDM" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if(ViewBag.Categories != null) { foreach (var dm in ViewBag.Categories) { <option value="@dm["MaDM"]">@dm["TenDM"]</option> } }
                        </select>
                    </div>
                    <div class="mb-3"><label class="fw-bold small">Giá bán (VNĐ)</label><input type="number" class="form-control" name="DonGia" required></div>
                    <div class="mb-3"><label class="fw-bold small">Link Ảnh (URL)</label><input type="text" class="form-control" name="HinhAnh"></div>
                    <!-- Đã xóa ô Mô tả -->
                    <button type="submit" class="btn btn-success w-100 fw-bold">TẠO MÓN</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa Món Ăn -->
<div class="modal fade" id="editProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">Cập Nhật Món Ăn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form action="/Menu/Edit" method="POST">
                    <input type="hidden" name="MaSP" id="editMaSP">
                    <div class="mb-3"><label class="fw-bold small">Tên sản phẩm</label><input type="text" class="form-control" name="TenSP" id="editTenSP" required></div>
                    <div class="mb-3">
                        <label class="fw-bold small">Danh mục sản phẩm</label>
                        <select class="form-select" name="MaDM" id="editMaDM" required>
                            @if(ViewBag.Categories != null) { foreach (var dm in ViewBag.Categories) { <option value="@dm["MaDM"]">@dm["TenDM"]</option> } }
                        </select>
                    </div>
                    <div class="mb-3"><label class="fw-bold small">Giá bán (VNĐ)</label><input type="number" class="form-control" name="DonGia" id="editDonGia" required></div>
                    <div class="mb-3">
                        <label class="fw-bold small">Trạng thái</label>
                        <select class="form-select" name="TrangThai" id="editTrangThai">
                            <option value="true">Đang bán</option>
                            <option value="false">Ngừng bán</option>
                        </select>
                    </div>
                    <div class="mb-3"><label class="fw-bold small">Link Ảnh (URL)</label><input type="text" class="form-control" name="HinhAnh" id="editHinhAnh"></div>
                    <!-- Đã xóa ô Mô tả -->
                    <button type="submit" class="btn btn-primary w-100 fw-bold">LƯU CẬP NHẬT</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditModal(maSP) {
        fetch('/Menu/GetProduct/' + maSP)
            .then(response => {
                if (!response.ok) throw new Error("Lỗi kết nối");
                return response.json();
            })
            .then(res => {
                if(res.success) {
                    document.getElementById('editMaSP').value = res.data.maSP;
                    document.getElementById('editTenSP').value = res.data.tenSP;
                    document.getElementById('editMaDM').value = res.data.maDM;
                    document.getElementById('editDonGia').value = res.data.donGia;
                    document.getElementById('editHinhAnh').value = res.data.hinhAnh;
                    document.getElementById('editTrangThai').value = res.data.trangThai ? 'true' : 'false';
                    
                    var myModal = new bootstrap.Modal(document.getElementById('editProductModal'));
                    myModal.show();
                } else {
                    alert("Lỗi: " + res.message);
                }
            })
            .catch(error => {
                alert("Lỗi hệ thống: " + error.message);
            });
    }
</script>