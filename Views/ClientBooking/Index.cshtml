@{ 
    Layout = null; // Tắt Layout của Admin, khách hàng sẽ không thấy thanh Menu bên trái
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt Bàn - Koi Cafe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            /* Ảnh nền làm mờ đi một chút để nổi bật Form đặt bàn */
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?q=80&w=2047&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .booking-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            padding: 40px;
            width: 100%;
            max-width: 500px;
        }
    </style>
</head>
<body>
    <div class="container px-3">
        <div class="booking-card mx-auto">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary"><i class="fas fa-coffee me-2"></i>KOI CAFE</h2>
                <p class="text-muted">Vui lòng điền thông tin để giữ chỗ tốt nhất</p>
            </div>
            
            <form id="bookingForm" onsubmit="submitBooking(event)">
                <div class="mb-3">
                    <label class="fw-bold text-dark mb-1">Tên người đặt</label>
                    <input type="text" id="tenKhach" class="form-control form-control-lg" placeholder="VD: Nguyễn Văn A" required>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-dark mb-1">Số điện thoại</label>
                    <input type="tel" id="soDienThoai" class="form-control form-control-lg" placeholder="VD: 0912345678" required>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="fw-bold text-dark mb-1">Số lượng khách</label>
                        <input type="number" id="soNguoi" class="form-control form-control-lg" min="1" value="2" required>
                    </div>
                    <div class="col-6 mb-3">
                        <label class="fw-bold text-dark mb-1">Giờ đến dự kiến</label>
                        <input type="datetime-local" id="thoiGianDat" class="form-control form-control-lg" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold py-3 mt-3 fs-5 shadow-sm">
                    <i class="fas fa-paper-plane me-2"></i> GỬI YÊU CẦU ĐẶT BÀN
                </button>
            </form>
        </div>
    </div>

    <script>
        // Tự động set giờ mặc định trên ô chọn thời gian là: Hiện tại + 1 tiếng
        window.onload = function() {
            let now = new Date();
            now.setHours(now.getHours() + 1);
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('thoiGianDat').value = now.toISOString().slice(0,16);
        };

        function submitBooking(e) {
            e.preventDefault();
            
            let payload = new FormData();
            payload.append('tenKhach', document.getElementById('tenKhach').value);
            payload.append('soDienThoai', document.getElementById('soDienThoai').value);
            payload.append('soNguoi', document.getElementById('soNguoi').value);
            payload.append('thoiGianDat', document.getElementById('thoiGianDat').value);

            fetch('/ClientBooking/SubmitBooking', {
                method: 'POST',
                body: payload
            })
            .then(res => res.json())
            .then(res => {
                if(res.success) {
                    alert(res.message);
                    document.getElementById('bookingForm').reset(); // Xóa trắng form
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
</body>
</html>