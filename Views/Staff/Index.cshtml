@model List<KoiCafe.Controllers.NhanVienModel>
@{ ViewData["Title"] = "Quản Lý Tài Khoản Nhân Sự"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark m-0"><i class="fas fa-users-cog text-primary me-2"></i> DANH SÁCH TÀI KHOẢN</h4>
    <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addStaffModal">
        <i class="fas fa-user-plus me-1"></i> CẤP TÀI KHOẢN MỚI
    </button>
</div>

@if (TempData["Error"] != null) { <div class="alert alert-danger shadow-sm">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert alert-success shadow-sm">@TempData["Success"]</div> }

<div class="bg-white p-0 shadow-sm rounded overflow-hidden">
    <table class="table table-hover align-middle text-center m-0">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Họ Tên</th>
                <th>Chức Vụ</th>
                <th>Tên Đăng Nhập</th>
                <th>Số Điện Thoại</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nv in Model)
            {
                string badge = nv.VaiTro == "Admin" ? "bg-danger" : "bg-info text-dark";
                <tr>
                    <td class="fw-bold text-secondary">#@nv.MaNV</td>
                    <td class="fw-bold text-primary">@nv.TenNV</td>
                    <td><span class="badge @badge px-3 py-2 fs-6">@nv.VaiTro</span></td>
                    <td class="fw-bold">@nv.TenDangNhap</td>
                    <td>@nv.SoDienThoai</td>
                    <td>
                        @if (nv.TenDangNhap != "admin") // Không cho phép sửa/xóa nick admin mặc định để tránh mất quyền
                        {
                            <button class="btn btn-sm btn-outline-primary fw-bold me-1" onclick="openEditModal(@nv.MaNV, '@nv.TenNV', '@nv.SoDienThoai', '@nv.VaiTro', '@nv.TenDangNhap')">
                                <i class="fas fa-edit"></i> Sửa
                            </button>
                            <button class="btn btn-sm btn-outline-danger fw-bold" onclick="deleteStaff(@nv.MaNV)"><i class="fas fa-trash-alt"></i> Xóa</button>
                        }
                        else
                        {
                            <span class="text-muted small fw-bold"><i class="fas fa-shield-alt text-danger"></i> Tối cao</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal THÊM TÀI KHOẢN -->
<div class="modal fade" id="addStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" action="/Staff/AddStaff" method="post">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">Cấp Tài Khoản Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="fw-bold mb-1">Họ Tên</label>
                        <input type="text" name="tenNV" class="form-control" required>
                    </div>
                    <div class="col-6 mb-3">
                        <label class="fw-bold mb-1">Số Điện Thoại</label>
                        <input type="text" name="sdt" class="form-control">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Phân Quyền</label>
                    <select name="vaiTro" class="form-select fw-bold text-primary">
                        <option value="Nhân viên">👨‍🍳 Nhân viên (Chỉ bán hàng)</option>
                        <option value="Admin">👑 Admin (Toàn quyền)</option>
                    </select>
                </div>
                <hr>
                <div class="mb-3">
                    <label class="fw-bold mb-1 text-danger">Tên Đăng Nhập</label>
                    <input type="text" name="username" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1 text-danger">Mật Khẩu</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary fw-bold w-100 py-2">TẠO TÀI KHOẢN</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal SỬA TÀI KHOẢN -->
<div class="modal fade" id="editStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" action="/Staff/EditStaff" method="post">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold">Chỉnh Sửa Tài Khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="maNV" id="editMaNV">
                <div class="mb-3">
                    <label class="fw-bold mb-1 text-muted">Tên Đăng Nhập (Không được sửa)</label>
                    <input type="text" id="editUsername" class="form-control bg-light" readonly>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="fw-bold mb-1">Họ Tên</label>
                        <input type="text" name="tenNV" id="editTenNV" class="form-control" required>
                    </div>
                    <div class="col-6 mb-3">
                        <label class="fw-bold mb-1">Số Điện Thoại</label>
                        <input type="text" name="sdt" id="editSDT" class="form-control">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold mb-1">Phân Quyền</label>
                    <select name="vaiTro" id="editVaiTro" class="form-select fw-bold text-primary">
                        <option value="Nhân viên">👨‍🍳 Nhân viên</option>
                        <option value="Admin">👑 Admin</option>
                    </select>
                </div>
                <hr>
                <div class="mb-3">
                    <label class="fw-bold mb-1 text-danger">Đổi Mật Khẩu (Tùy chọn)</label>
                    <input type="password" name="password" class="form-control" placeholder="Bỏ trống nếu không muốn đổi mật khẩu...">
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2"><i class="fas fa-save"></i> LƯU THAY ĐỔI</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditModal(maNV, tenNV, sdt, vaiTro, username) {
        document.getElementById('editMaNV').value = maNV;
        document.getElementById('editTenNV').value = tenNV;
        document.getElementById('editSDT').value = sdt;
        document.getElementById('editVaiTro').value = vaiTro;
        document.getElementById('editUsername').value = username;
        new bootstrap.Modal(document.getElementById('editStaffModal')).show();
    }

    function deleteStaff(id) {
        if(!confirm("Xác nhận xóa vĩnh viễn tài khoản này? (Lưu ý: Không thể hoàn tác)")) return;
        fetch(`/Staff/DeleteStaff?id=${id}`, { method: 'POST' })
        .then(res => res.json()).then(res => {
            if(res.success) {
                alert(res.message);
                location.reload();
            }
            else {
                // Hiển thị LỖI THẬT SỰ từ Backend đẩy lên
                alert("❌ Lỗi từ Database: " + res.message);
            }
        });
    }
</script>