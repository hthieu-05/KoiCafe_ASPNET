@model List<KoiCafe.Models.NhanVienModel>
@{
    Layout = null; 
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Nhân Sự - Koi Cafe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">
    <div class="container bg-white p-4 shadow-sm rounded">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-dark m-0"><i class="fas fa-users text-primary me-2"></i> QUẢN LÝ NHÂN SỰ</h4>
            <div>
                <a href="/Dashboard" class="btn btn-secondary fw-bold me-2">Về Tổng Quan</a>
                <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addStaffModal">Thêm Nhân Viên</button>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success fw-bold text-center">@TempData["Success"]</div>
        }

        <table class="table table-hover align-middle text-center">
            <thead class="table-dark">
                <tr><th>Mã NV</th><th>Họ Tên</th><th>Số Điện Thoại</th><th>Vai Trò</th><th>Tên Đăng Nhập</th></tr>
            </thead>
            <tbody>
                @foreach (var nv in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">NV-@nv.MaNV</td>
                        <td class="fw-bold text-dark">@nv.TenNV</td>
                        <td>@nv.SoDienThoai</td>
                        <td>
                            @if(nv.VaiTro == "Admin") { <span class="badge bg-danger">Quản Trị Viên</span> }
                            else { <span class="badge bg-info text-dark">Thu Ngân</span> }
                        </td>
                        <td class="text-primary fw-bold">@nv.TenDangNhap</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modal Thêm Nhân Viên -->
    <div class="modal fade" id="addStaffModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Thêm Nhân Sự Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form action="/Staff/Create" method="POST">
                        <div class="mb-3">
                            <label class="fw-bold small">Họ tên nhân viên</label>
                            <input type="text" class="form-control" name="TenNV" required>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold small">Số điện thoại</label>
                            <input type="text" class="form-control" name="SoDienThoai">
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold small">Vai trò</label>
                            <select class="form-select" name="VaiTro">
                                <option value="Thu Ngân">Thu Ngân (Chỉ bán hàng)</option>
                                <option value="Admin">Quản Trị Viên (Full quyền)</option>
                            </select>
                        </div>
                        <hr>
                        <h6 class="fw-bold text-primary mb-3">Tạo Tài Khoản Đăng Nhập</h6>
                        <div class="mb-3">
                            <label class="fw-bold small">Tên đăng nhập (Username)</label>
                            <input type="text" class="form-control" name="TenDangNhap" required>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold small">Mật khẩu</label>
                            <input type="password" class="form-control" name="MatKhau" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">TẠO TÀI KHOẢN</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>