@model KoiCafe.Models.BookingViewModel

<!-- KHAI BÁO LAYOUT CHUNG (Bao gồm Menu trái, Header) nếu bạn có file _Layout.cshtml -->
@{
    Layout = null; // Tạm thời để null nếu bạn copy nguyên xi HTML cũ
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Đặt Bàn - Koi Cafe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Cắt ngắn CSS cho gọn -->
</head>
<body>
    <!-- (Phần Sidebar HTML bạn copy y hệt cũ vào đây) -->

    <div class="main-content">
        <!-- Thay vì <% bookings.filter... %>, trong C# chúng ta dùng LINQ: -->
        <table class="table">
            <tbody>
                @foreach(var b in Model.Bookings.Where(x => x.TrangThai == "Chờ xác nhận"))
                {
                    <tr>
                        <td class="fw-bold text-danger">#BK-@b.MaDatBan</td>
                        <td><b>@b.TenKhachHang</b><br><span class="small text-muted">@b.SoDienThoai</span></td>
                        <td>@b.NgayDat.ToString("dd/MM/yyyy") - @b.GioDat</td>
                        <td><span class="badge bg-dark">@b.SoNguoi</span></td>
                        <td>
                            <button class="btn btn-sm btn-success fw-bold" onclick="openAssignTableModal(@b.MaDatBan, @b.SoNguoi)">Xếp Bàn</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modal chọn bàn -->
    <select id="assignTableSelect" class="form-select">
        @foreach(var tb in Model.Tables)
        {
            <!-- Cú pháp nối chuỗi cực kỳ sạch sẽ trong C# Razor -->
            <option value="@tb.MaBan">@(string.IsNullOrEmpty(tb.KhuVuc) ? "" : tb.KhuVuc + " - ") @tb.TenBan (Loại @tb.SucChua chỗ)</option>
        }
    </select>

    <script>
        // API gọi thẳng vào Controller của C#
        function updateBooking(id, status) {
            fetch('/Bookings/UpdateStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, status: status })
            }).then(res => res.json()).then(data => {
                if(data.success) location.reload();
            });
        }
    </script>
</body>
</html>