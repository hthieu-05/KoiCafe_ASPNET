@model KoiCafe.Models.PosViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>POS - Máy Bán Hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; height: 100vh; overflow: hidden; }
        .pos-navbar { background: #212529; height: 60px; }
        .product-card { cursor: pointer; transition: 0.1s; border: none; border-radius: 12px; }
        .product-card:active { transform: scale(0.95); background-color: #f8f9fa; }
        .cart-container { background: white; height: calc(100vh - 60px); display: flex; flex-direction: column; }
        .cart-items { flex-grow: 1; overflow-y: auto; padding: 15px; }
        .products-container { height: calc(100vh - 60px); overflow-y: auto; padding: 20px; }
        .note-input { font-size: 0.85rem; background-color: #fff8e1; border: 1px dashed #ffc107; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark pos-navbar py-0">
        <div class="container-fluid">
            <a class="btn btn-outline-light btn-sm fw-bold" href="/Dashboard"><i class="fas fa-arrow-left"></i> Về Dashboard</a>
            <span class="navbar-text text-warning fw-bold mx-auto fs-5"><i class="fas fa-desktop"></i> KOI CAFE POS</span>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- CỘT 1: CHỌN MÓN -->
            <div class="col-md-7 col-lg-8 products-container">
                <div class="row g-3">
                    @foreach (var sp in Model.Products)
                    {
                        <div class="col-xl-3 col-lg-4 col-sm-6">
                            <div class="card product-card h-100 text-center p-3 shadow-sm" onclick="addToCart(@sp.MaSP, '@sp.TenSP', @sp.DonGia)">
                                <div class="display-4 mb-2">☕</div>
                                <h6 class="fw-bold mb-1 text-dark text-truncate">@sp.TenSP</h6>
                                <div class="text-danger fw-bold">@sp.DonGia.ToString("N0") đ</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- CỘT 2: GIỎ HÀNG -->
            <div class="col-md-5 col-lg-4 cart-container border-start">
                <div class="p-3 bg-light border-bottom">
                    <select id="maBan" class="form-select form-select-lg fw-bold shadow-sm text-primary" onchange="loadTableOrder()">
                        <option value="">-- CHỌN BÀN GỌI MÓN --</option>
                        @foreach (var b in Model.Tables)
                        {
                            <option value="@b.MaBan">
                                @(string.IsNullOrEmpty(b.KhuVuc) ? "" : b.KhuVuc + " - ") Bàn @b.TenBan @(b.TrangThai != "Trong" ? "(Đang phục vụ)" : "")
                            </option>
                        }
                    </select>
                </div>
                
                <div class="cart-items bg-white" id="cartItems">
                    <div class="text-center text-muted mt-5"><i class="fas fa-receipt fs-1 mb-3"></i><br>Chưa có món nào</div>
                </div>

                <div class="p-3 bg-light border-top shadow-lg">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 fw-bold text-dark">TỔNG CỘNG:</span>
                        <span class="fs-2 fw-bold text-danger" id="cartTotal">0 đ</span>
                    </div>
                    
                    <div class="row g-2">
                        <div class="col-3">
                            <button class="btn btn-outline-danger w-100 fw-bold py-3 shadow-sm" onclick="promptCancelOrder()"><i class="fas fa-trash-alt"></i> HỦY</button>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-warning w-100 fw-bold py-3 shadow-sm text-dark" onclick="processOrder('save')"><i class="fas fa-save"></i> LƯU</button>
                        </div>
                        <div class="col-5">
                            <!-- Sửa nút Thu Tiền để mở Modal -->
                            <button class="btn btn-success w-100 fw-bold py-3 shadow-sm" onclick="openPaymentModal()"><i class="fas fa-check-circle"></i> THU TIỀN</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL THANH TOÁN (TÍCH ĐIỂM) -->
    <div class="modal fade" id="paymentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i> Xác Nhận Thanh Toán</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <h2 class="text-center text-danger fw-bold mb-4" id="modalTotalAmount">0 đ</h2>
                    <div class="mb-3">
                        <label class="fw-bold text-primary mb-2">Tích điểm Khách VIP (Không bắt buộc)</label>
                        <div class="input-group">
                            <input type="tel" id="payPhone" class="form-control" placeholder="Nhập SĐT khách hàng...">
                            <button class="btn btn-primary fw-bold" onclick="checkVip()"><i class="fas fa-search"></i> Kiểm tra</button>
                        </div>
                    </div>
                    <!-- Khu vực hiển thị kết quả kiểm tra SĐT -->
                    <div id="vipResult" class="alert alert-info d-none mb-0"></div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-success w-100 fw-bold py-2 fs-5" onclick="submitPayment()"><i class="fas fa-check"></i> HOÀN TẤT THU TIỀN</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let cart = [];
        let paymentTotal = 0;

        function loadTableOrder() {
            const maBan = document.getElementById('maBan').value;
            if(!maBan) { cart = []; renderCart(); return; }

            fetch('/Pos/GetTableOrder/' + maBan)
                .then(res => res.json())
                .then(data => {
                    cart = data.success && data.cart.length > 0 ? data.cart : [];
                    renderCart();
                });
        }

        function addToCart(maSP, tenSP, donGia) {
            let item = cart.find(i => i.maSP == maSP && (i.ghiChu == "" || !i.ghiChu));
            if(item) item.soLuong++; 
            else cart.push({maSP, tenSP, donGia, soLuong: 1, ghiChu: ''});
            renderCart();
        }

        function changeQty(index, delta) {
            cart[index].soLuong += delta;
            if(cart[index].soLuong <= 0) cart.splice(index, 1);
            renderCart();
        }

        // Cập nhật giá trị ô text Ghi Chú vào mảng cart
        function updateNote(index, value) {
            cart[index].ghiChu = value;
        }

        function renderCart() {
            let html = ''; paymentTotal = 0;
            if(cart.length === 0) {
                html = '<div class="text-center text-muted mt-5"><i class="fas fa-receipt fs-1 mb-3"></i><br>Chưa có món nào</div>';
            } else {
                cart.forEach((item, i) => {
                    paymentTotal += item.donGia * item.soLuong;
                    html += `
                    <div class="mb-2 p-2 border rounded bg-white shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div style="flex: 1;"><div class="fw-bold">${item.tenSP}</div><div class="text-danger small fw-bold">${item.donGia.toLocaleString('vi-VN')} đ</div></div>
                            <div class="d-flex align-items-center">
                                <button class="btn btn-sm btn-outline-secondary px-2 fw-bold" onclick="changeQty(${i}, -1)">-</button>
                                <span class="mx-2 fw-bold fs-5">${item.soLuong}</span>
                                <button class="btn btn-sm btn-outline-secondary px-2 fw-bold" onclick="changeQty(${i}, 1)">+</button>
                            </div>
                        </div>
                        <!-- Ô NHẬP GHI CHÚ -->
                        <input type="text" class="form-control form-control-sm note-input" placeholder="✍️ Ghi chú (Ví dụ: Ít đá, nhiều sữa...)" value="${item.ghiChu || ''}" onchange="updateNote(${i}, this.value)">
                    </div>`;
                });
            }
            document.getElementById('cartItems').innerHTML = html;
            document.getElementById('cartTotal').innerText = paymentTotal.toLocaleString('vi-VN') + ' đ';
        }

        // Mở Modal Thanh Toán
        function openPaymentModal() {
            if(!document.getElementById('maBan').value) return alert('Vui lòng chọn Bàn trước!');
            if(cart.length === 0) return alert('Chưa có món nào để thu tiền!');
            
            document.getElementById('modalTotalAmount').innerText = paymentTotal.toLocaleString('vi-VN') + ' đ';
            document.getElementById('payPhone').value = '';
            document.getElementById('vipResult').classList.add('d-none');
            
            new bootstrap.Modal(document.getElementById('paymentModal')).show();
        }

        // Gọi API kiểm tra Khách hàng
        function checkVip() {
            let sdt = document.getElementById('payPhone').value.trim();
            if(!sdt) return alert("Vui lòng nhập số điện thoại");

            fetch('/Customer/CheckPhone?sdt=' + sdt)
            .then(res => res.json())
            .then(res => {
                let div = document.getElementById('vipResult');
                div.classList.remove('d-none', 'alert-info', 'alert-danger');
                
                if(res.success) {
                    div.classList.add('alert-info');
                    // Hiển thị dự kiến số điểm được cộng (Tổng tiền / 10000)
                    let diemDuKien = Math.floor(paymentTotal / 10000);
                    div.innerHTML = `<strong>👤 ${res.data.hoTen}</strong> (Đang có: ${res.data.diemTichLuy} điểm) <br> <span class="text-success"><i class="fas fa-arrow-up"></i> Sẽ được cộng thêm <b>${diemDuKien}</b> điểm.</span>`;
                } else {
                    div.classList.add('alert-danger');
                    div.innerHTML = `❌ Không tìm thấy SĐT này. Vui lòng đăng ký khách mới trong trang Quản lý.`;
                }
            });
        }

        // Submit LƯU (Không thanh toán)
        function processOrder(action) {
            let maBan = document.getElementById('maBan').value;
            if(!maBan) return alert('Vui lòng chọn Bàn trước!');
            if(cart.length === 0) return alert('Chưa có món nào!');

            fetch('/Pos/ProcessOrder', {
                method: 'POST', headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ maBan: parseInt(maBan), action: action, sdtKhach: "", cart: cart })
            }).then(r => r.json()).then(res => {
                if(res.success) { alert(res.message); location.reload(); } else alert('Lỗi: ' + res.message);
            });
        }

        // Submit THANH TOÁN (Trong Modal)
        function submitPayment() {
            let maBan = document.getElementById('maBan').value;
            let sdt = document.getElementById('payPhone').value.trim();

            fetch('/Pos/ProcessOrder', {
                method: 'POST', headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ maBan: parseInt(maBan), action: 'pay', sdtKhach: sdt, cart: cart })
            }).then(r => r.json()).then(res => {
                if(res.success) { alert(res.message); location.reload(); } else alert('Lỗi: ' + res.message);
            });
        }

        function promptCancelOrder() {
            let maBan = document.getElementById('maBan').value;
            if(!maBan) return alert('Vui lòng chọn Bàn trước!');
            let lyDo = prompt("Nhập lý do hủy hóa đơn (Bắt buộc):");
            if(lyDo) {
                fetch('/Pos/ProcessOrder', {
                    method: 'POST', headers: {'Content-Type': 'application/json'}, 
                    body: JSON.stringify({ maBan: parseInt(maBan), action: 'cancel', lyDoHuy: lyDo, cart: [] })
                }).then(r => r.json()).then(res => {
                    if(res.success) { alert(res.message); location.reload(); }
                });
            }
        }
    </script>
</body>
</html>